# Copy this file to ".env" and change what you need.

PORT=3000
# Tasks are tracked from this date (blank = the day the portal is first started)
GO_LIVE_DATE=
# Admins (comma separated, exact names as in the checklist)
ADMIN_NAMES=Niraj Goel
# Password for admins (team members log in by picking their name, no password)
DEFAULT_PASSWORD=123456$$
# Daily tasks are created on these days: 0=Sun 1=Mon ... 6=Sat
WORKING_DAYS=1,2,3,4,5,6
# approval = proof upload mandatory only for tasks that need approval ; all = for every task
PROOF_REQUIRED_FOR=approval
MAX_UPLOAD_MB=20

# E-mail reminders (leave SMTP_HOST blank to switch off)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Hour (24h) when the daily digest goes out
DIGEST_HOUR=9
# Link put inside the e-mails
PORTAL_URL=
